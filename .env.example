# ─── Site Configuration ───────────────────────────────────────────────────────
# Canonical URL of your deployment (no trailing slash).
# Used by SEO meta tags, JSON-LD structured data, and the sitemap.
SITE_URL=https://your-domain.com

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID. Leave blank to disable analytics entirely.
# Privacy-friendly: IP anonymization enabled, no ad signals.
VITE_GA4_ID=
